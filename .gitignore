# ==================================================
# Root .gitignore for Hostel Laundry Management System
# ==================================================

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java / Maven build artifacts
backend/target/
backend/*.jar
backend/*.war
*.class

# IDE & Editor files
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Frontend dependencies and builds
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnp
frontend/.pnp.js

# Environment variable files
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
.env
.env.local

# Vercel
.vercel
